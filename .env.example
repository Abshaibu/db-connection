# Database connection values for testing
# Supported types: postgres, mysql, mongodb, redis
DB_TYPE=postgres
DB_URL=postgres://username:password@localhost:5432/mydatabase

# Example MongoDB connection string:
# DB_URL=mongodb://username:password@localhost:27017/mydatabase

# Example Redis connection string:
# DB_URL=redis://localhost:6379

# Optional port for the web app
PORT=3000
